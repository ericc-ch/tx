{
  "name": "tx",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.3.14",
      "@types/node": "^25.9.1",
      "typescript": "^6.0.3",
      "vitest": "^4.1.8"
    },
    "catalogs": {
      "effect": {
        "effect": "^4.0.0-beta.78",
        "@effect/platform-browser": "^4.0.0-beta.78",
        "@effect/platform-node": "^4.0.0-beta.78",
        "@effect/vitest": "^4.0.0-beta.78"
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "format": "oxfmt",
    "lint": "oxlint --fix",
    "check": "bun run typecheck && bun run test && bun run lint",
    "prepare": "simple-git-hooks && effect-language-service patch && bun scripts/references.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b && bun run --filter @tx/extension typecheck"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@types/node": "catalog:",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run check"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": []
}
