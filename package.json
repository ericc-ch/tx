{
  "name": "tx",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "format": "oxfmt",
    "lint": "oxlint --fix",
    "check": "bun run typecheck && bun run test && bun run lint",
    "prepare": "simple-git-hooks && effect-language-service patch && bun scripts/references.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b && bun run --filter @tx/extension typecheck"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@types/node": "^25.9.1",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run check"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": []
}
